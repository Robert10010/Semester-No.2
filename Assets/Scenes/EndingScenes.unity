  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2135e1371eb59474aa0ad0746c27056d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EndingSceneController
  endingTextUI: {fileID: 2072027095}
  statsTextUI: {fileID: 547578254}
  showStats: 0
  endingContentCanvasGroup: {fileID: 0}
  fadeDuration: 1.5
  typingSpeed: 0.05
  mainSceneName: MainScene
  debugEndingType: 0
  endingTimeline: {fileID: 359745292}
  successSlides:
  - text: "\u606D\u559C\u4F5C\u70BA\u5FC3\u9748\u5F15\u8DEF\u4EBA\u662F\u76F8\u7576\u512A\u79C0\u7684\n\u5C0E\u5E2B\u9019\u908A\u4E5F\u6709\u53E6\u4E00\u5957\u8AB2\u7A0B\n\u3010\u5FC3\u9748\u9818\u5C0E\u8AB2\u7A0B\u3011"
    slideSprite: {fileID: 21300000, guid: 17af3bf1be186854b97fd37dc07b9e37, type: 3}
    slideImageObject: {fileID: 14301187}
  - text: "\u6703\u544A\u8A34\u4F60\u5982\u4F55\u6210\u70BA\u50CF\u5C0E\u5E2B\u4E00\u6A23\n\u5E36\u9818\u5927\u5BB6\u770B\u898B\u5FC3\u4E2D\u7684\u5149\r\n\u5E0C\u671B\u4F60\u5C07\u4F86\u4E5F\u80FD\u5920\u6210\u70BA\u512A\u79C0\u7684\u5C0E\u5E2B\r\n\u73FE\u5728\u5C31\u99AC\u4E0A\u52A0\u5165\u5427\uFF01"
    slideSprite: {fileID: 21300000, guid: 3bc1b1e6f6421ee439bb7252b5f31e71, type: 3}
    slideImageObject: {fileID: 14301187}
  failureSlides:
  - text: "\u4F60\u505A\u70BA\u4E00\u500B\u5F15\u9818\u8FF7\u9014\u4E4B\u4EBA\u7684\u5F15\u8DEF\u4EBA\u80FD\u529B\u4E0D\u5920\r\n\u60F3\u60F3\u4F60\u505A\u70BA\u4ED6\u5011\u7684\u5F15\u8DEF\u4EBA\n\u537B\u6C92\u6709\u8FA6\u6CD5\u70BA\u4ED6\u5011\u5E36\u4F86\u5E78\u798F\u4EE5\u53CA\u6B63\u78BA\u7684\u65B9\u5411\r\n\u5C31\u662F\u4E00\u4EF6\u7F6A\u5927\u60E1\u6975\u7684\u4E8B\u60C5
      \n\u4F60\u6CE8\u5B9A\u8981\u70BA\u90A3\u4E9B\u4EBA\u8D16\u7F6A"
    slideSprite: {fileID: 21300000, guid: 300cf4f0c4875d841a52bc7e8285fb31, type: 3}
    slideImageObject: {fileID: 14301187}
  - text: "\u4F46\u6C92\u95DC\u4FC2 \u53EA\u8981\u4F60\u4E0A\u9019\u9805\u3010\u5FC3\u9748\u6D17\u6ECC\u8AB2\u7A0B\u3011\n\u4FDD\u8B49\u4F60\u80FD\u5920\u6D17\u6E05\u4F60\u7684\u7F6A\u5B7D\r\n\u9019\u90FD\u662F\u4F60\u7684\u8AB2\u984C
      \u662F\u4F60\u5FC5\u9808\u514B\u670D\u7684\u574E\r\n\u4F86\u5427!\u73FE\u5728\u5C31\u99AC\u4E0A\u52A0\u5165\u5427"
    slideSprite: {fileID: 21300000, guid: 3bc1b1e6f6421ee439bb7252b5f31e71, type: 3}
    slideImageObject: {fileID: 14301187}
  interestingSlides:
  - text: "\u5FC3\u9748\u80A5\u7682\u7684\u8A98\u60D1\u592A\u5927\u4E86\n\u4F60\u5FCD\u4E0D\u4F4F\u8CB7\u592A\u591A\n\u6700\u5F8C\u7834\u7522\u4E86"
    slideSprite: {fileID: 21300000, guid: 9e0b646ae7a53f940a40ea0a10eba3b2, type: 3}
    slideImageObject: {fileID: 14301187}
  escapeSlides:
  - text: "\u7D50\u679C\u4F60\u767C\u73FE\u4F60\u80FD\u8D85\u8D8A\u5C0E\u5E2B\n\u5C31\u6C7A\u5B9A\u81EA\u5DF1\u55AE\u98DB\n\u5275\u5EFA\u5C6C\u65BC\u81EA\u5DF1\u7684\u5FC3\u9748\u8AB2\u7A0B\n\u771F\u662F\u53EF\u559C\u53EF\u8CC0
      \u53EF\u559C\u53EF\u8CC0"
    slideSprite: {fileID: 21300000, guid: e80ea67613445834ba8138e4c56f5f4c, type: 3}
    slideImageObject: {fileID: 14301187}
  slideImageDisplay: {fileID: 0}
